# ============================================================
# AI 串口调试助手 · 根 .gitignore
# 作用域：整个仓库（含 ai-serial-assistant-app 等子工程）
# ============================================================

# ---------- 依赖（Node / npm / pnpm）----------
/**/node_modules

# ---------- 构建 / 打包产物（Vite / Electron / React）----------
/**/dist
/**/build
/**/out
/**/release
/**/release-builds
/**/release-temp
/**/release-v1
/**/release-v2
/**/.builder-cache
*.log

# ---------- 可执行安装包 ----------
*.exe
*.dmg
*.AppImage
*.zip

# ---------- 编辑器 / IDE ----------
/**/.vscode
*.code-workspace
.idea

# ---------- 操作系统缓存 ----------
.DS_Store
/**/.DS_Store
Thumbs.db
/**/Thumbs.db

# ---------- AI工具缓存 ----------
/**/.workbuddy
/**/.trae

# ---------- 临时调试脚本 ----------
/**/tests/tmp-*

# ---------- 设计源文件（无关交付物）----------
/**/AI串口助手前端界面设计

# 参考开源
/**/llm-pid-tuner

# ---------- 应用运行 / 缓存产物 ----------
*.db
/**/.electron-builder-cache
/**/waveform_results

# ---------- 宣传片工程：忽略渲染输出与 HyperFrames 工具状态（生成物）----------
/ai-serial-assistant-app/promo-video/renders/
/ai-serial-assistant-app/promo-video/.hyperframes/
# edge-tts 生成的配音分片与混音轨，可由 prepare-audio.py 复现
/ai-serial-assistant-app/promo-video/assets/voice/
# 输入法（搜狗）在本目录运行时写下的垃圾文件，与工程无关
/ai-serial-assistant-app/promo-video/*.config
/ai-serial-assistant-app/promo-video/*.bin
/ai-serial-assistant-app/promo-video/*.ini
/ai-serial-assistant-app/promo-video/*.dat
/ai-serial-assistant-app/promo-video/*.stat
/ai-serial-assistant-app/promo-video/Backup/
# 配音 / 配乐试听样片（本地选型用）
/音乐试听/
# 构建终端原始输出
/视频构建执行终端输出.txt

# ---------- Python 缓存 ----------
__pycache__/
*.pyc

# ============================================================
# AI 串口调试助手 · 根 .gitignore
# 作用域：整个仓库（含 ai-serial-assistant-app 等子工程）
# ============================================================

# ---------- 依赖（Node / npm / pnpm）----------
/**/node_modules

# ---------- 构建 / 打包产物（Vite / Electron / React）----------
/**/dist
/**/build
/**/out
/**/release
/**/release-builds
*.log

# ---------- 可执行安装包 ----------
*.exe
*.dmg
*.AppImage
*.zip

# ---------- 编辑器 / IDE ----------
/**/.vscode
*.code-workspace
.idea

# ---------- 操作系统缓存 ----------
.DS_Store
/**/.DS_Store
Thumbs.db
/**/Thumbs.db

# ---------- WorkBuddy / 本地工具缓存 ----------
/**/.workbuddy

# ---------- 设计源文件（无关交付物）----------
/**/AI串口助手前端界面设计
